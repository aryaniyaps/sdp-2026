# Everything except the GPU tunnel sits behind one access code. Only the landing page, the terminal
# project/session controls, graph reads and confirmed namespace clears are reachable; the memory API itself (retain, recall, jobs) is not
# exposed. conf.d/*.caddy adds routes that carry their own authentication (the GPU tunnel).
__SITE_ADDRESS__ {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	import /etc/caddy/conf.d/*.caddy
	handle {
		basic_auth {
			admin __ACCESS_HASH__
		}
		handle /term/* {
			reverse_proxy term:7681
		}
		@frontend path /demo /graph /assets/*
		handle @frontend {
			reverse_proxy engine:8080
		}
		@graphapi {
			method GET
			path /api/v2/graph/projection /api/v2/graph/memories
		}
		handle @graphapi {
			reverse_proxy engine:8080
		}
		@dashboardapi {
			method GET POST
			path_regexp dashboard ^/api/v2/(projects|dashboard/sessions(/[0-9a-f-]+)?)$
		}
		handle @dashboardapi {
			reverse_proxy engine:8080
		}
		@clearapi {
			method POST
			path /api/v2/graph/clear
		}
		handle @clearapi {
			reverse_proxy engine:8080
		}
		handle / {
			redir /demo 302
		}
		handle {
			respond "not found" 404
		}
	}
}
